{
  "name": "TSC | NS Mat64 | ChrisTrains | TheJAG",
  "controls": [
    {
      "name": "LeftThrottle",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Regulator",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.12,
              0.25,
              0.37,
              0.5,
              0.62,
              0.75,
              0.87,
              1
            ],
            "invert": true
          }
        },
        {
          "type": "sync_control",
          "identifier": "Regulator",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.12,
              0.25,
              0.37,
              0.5,
              0.62,
              0.75,
              0.87,
              1
            ],
            "invert": true
          },
          "action_increase": {
            "keys": "a"
          },
          "action_decrease": {
            "keys": "d"
          }
        }
      ]
    },
    {
      "name": "SpeedbrakeLever",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          }
        },
        {
          "type": "sync_control",
          "identifier": "Reverser",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          },
          "action_increase": {
            "keys": "w"
          },
          "action_decrease": {
            "keys": "s"
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "TrainBrakeControl",
          "input_value": {
            "min": 0,
            "max": 1
          }
        },
        {
          "type": "sync_control",
          "identifier": "TrainBrakeControl",
          "input_value": {
            "min": 0,
            "max": 1
          },
          "action_increase": {
            "keys": "'"
          },
          "action_decrease": {
            "keys": ";"
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "v"
        },
        "action_deactivate": {
          "keys": "v"
        }
      }
    },
    {
      "name": "LeftThrottleButton",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "x"
        }
      }
    },
    {
      "name": "GearLever",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "DeadMansReset",
          "value": 1,
          "hold": false
        },
        "action_deactivate": {
          "controls": "DeadMansReset",
          "value": 0
        }
      }
    },
    {
      "name": "RightAuxButton",
      "assignment": {
        "type": "toggle",
        "threshold": 0.9,
        "action_activate": {
          "controls": "DeadManSystem",
          "value": 1,
          "hold": false
        },
        "action_deactivate": {
          "controls": "DeadManSystem",
          "value": 0,
          "hold": false
        }
      }
    },
    {
      "name": "RotaryIgnStart",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "h",
          "press_time": 0.1,
          "wait_time": 0.1
        }
      }
    },
    {
