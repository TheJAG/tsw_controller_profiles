        }
      ]
    },
    {
      "name": "ParkingBrake",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "v",
          "press_time": 0.1,
          "wait_time": 0.1
        },
        "action_deactivate": {
          "keys": "shift+v",
