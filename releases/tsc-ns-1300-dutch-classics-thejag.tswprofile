{
  "name": "TSC | NS 1300 | Dutch Classics | TheJAG",
  "controls": [
    {
      "name": "LeftThrottle",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "VRegulatorMain",
          "input_value": {
            "min": 0,
            "max": 40,
            "step": 1,
            "invert": true
          }
        },
        {
          "type": "sync_control",
          "identifier": "VRegulatorMain",
          "input_value": {
            "min": 0,
            "max": 40,
            "step": 1,
            "invert": true
          },
          "action_increase": {
            "keys": "a"
          },
          "action_decrease": {
            "keys": "d"
          }
        }
      ]
    },
    {
      "name": "SpeedbrakeLever",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser",
          "input_value": {
            "min": -1,
            "max": 1,
            "step": 1,
            "invert": true
          }
        },
        {
          "type": "sync_control",
          "identifier": "Reverser",
          "input_value": {
            "min": -1,
            "max": 1,
            "step": 1,
            "invert": true
          },
          "action_increase": {
            "keys": "w"
          },
          "action_decrease": {
            "keys": "s"
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "VTrainBrakeControl",
          "input_value": {
            "min": 0,
            "max": 1,
            "invert": true
          }
        },
        {
          "type": "sync_control",
          "identifier": "VTrainBrakeControl",
          "input_value": {
            "min": 0,
            "max": 1,
            "invert": true
          },
          "action_increase": {
            "keys": "'"
          },
          "action_decrease": {
            "keys": ";"
          }
        }
      ]
    },
    {
      "name": "FlapLever",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "VRegulatorWeakfield",
          "input_value": {
            "min": 0,
            "max": 6,
            "step": 1,
            "invert": true
          }
        },
        {
          "type": "sync_control",
          "identifier": "VRegulatorWeakfield",
          "input_value": {
            "min": 0,
            "max": 6,
            "step": 1,
            "invert": true
          },
          "action_increase": {
            "keys": "shift+a"
          },
          "action_decrease": {
            "keys": "shift+d"
          }
        }
      ]
    },
    {
      "name": "GearLever",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "VDodeman",
          "value": 1,
          "hold": false
        },
        "action_deactivate": {
          "controls": "VDodeman",
          "value": 0
        }
      }
    },
    {
      "name": "ParkingBrake",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "end"
        },
        "action_deactivate": {
          "keys": "end"
        }
      }
    },
    {
      "name": "LeftThrottleButton",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "space"
        }
      }
    },
    {
      "name": "RightThrottleButton",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "m"
        }
      }
    },
    {
      "name": "RotaryIgnStart",
      "assignment": {
        "type": "toggle",
        "threshold": 0.9,
        "action_activate": {
          "controls": "DS1",
          "value": 1,
          "hold": false
        },
        "action_deactivate": {
          "controls": "DS1",
          "value": 0,
          "hold": false
        }
      }
    },
    {
      "name": "RotaryCrank",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "DS",
          "value": 1,
          "hold": false
        },
        "action_deactivate": {
          "controls": "DS",
          "value": 0
        }
      }
    },
    {
      "name": "LeftEngineOn",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "shift+p",
          "press_time": 0.1,
          "wait_time": 0.1
        },
        "action_deactivate": {
          "keys": "shift+p",
          "press_time": 0.1,
          "wait_time": 0.1
        }
      }
    },
    {
      "name": "RightEngineOn",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "p",
          "press_time": 0.1,
          "wait_time": 0.1
        },
        "action_deactivate": {
          "keys": "p",
          "press_time": 0.1,
          "wait_time": 0.1
        }
      }
    },
    {
      "name": "RudderTrimLeft",
      "assignment": {
        "type": "momentary",
        "threshold": 0.5,
        "action_activate": {
          "keys": "t"
        }
      }
    },
    {
      "name": "RudderTrimRight",
      "assignment": {
        "type": "momentary",
        "threshold": 0.5,
        "action_activate": {
          "keys": "t"
        }
      }
    },
    {
      "name": "LeftAuxButton",
      "assignment": {
        "type": "momentary",
        "threshold": 0.5,
        "action_activate": {
          "keys": "ctrl+shift+i"
        }
      }
    },
    {
      "name": "RightAuxButton",
      "assignment": {
        "type": "toggle",
        "threshold": 0.9,
        "action_activate": {
          "controls": "EnableDodeman",
          "value": 1,
          "hold": false
        },
        "action_deactivate": {
          "controls": "EnableDodeman",
          "value": 0,
          "hold": false
        }
      }
    },
    {
      "name": "RoundAuxButton",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "ctrl+shift+end"
        }
      }
    },
    {
      "name": "AutoBrake0",
      "assignment": {
        "type": "toggle",
        "threshold": 0.9,
        "action_activate": {
          "controls": "SC1A",
          "value": 1,
          "hold": false
        },
        "action_deactivate": {
          "controls": "SC1A",
          "value": 0,
          "hold": false
        }
      }
    },
    {
      "name": "AutoBrake1",
      "assignment": {
        "type": "toggle",
        "threshold": 0.9,
        "action_activate": {
          "controls": "DV",
          "value": 1,
          "hold": false
        },
        "action_deactivate": {
          "controls": "DV",
          "value": 0,
          "hold": false
        }
      }
    },
    {
      "name": "AutoBrake2",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "ctrl+h+k"
        }
      }
    },
    {
      "name": "AutoBrake3",
      "assignment": {
        "type": "toggle",
        "threshold": 0.9,
        "action_activate": {
          "controls": "HandBrakeControl",
          "value": 0,
          "hold": false
        },
        "action_deactivate": {
          "controls": "HandBrakeControl",
          "value": 1,
          "hold": false
        }
      }
    }
  ],
