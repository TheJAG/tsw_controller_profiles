{
  "name": "TSW | Class 377 | DTG | TheJAG",
  "controls": [
    {
      "name": "SpeedbrakeLever",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser",
          "input_value": {
            "min": -0.5,
            "max": 1,
            "steps": [
              -0.5,
              0,
              0.5,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "PowerHandle",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              -0.6,
              -0.4,
              -0.2,
              0,
              0.25,
              0.5,
              0.75,
              1
            ]
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "MasterKey",
          "value": 1
        },
        "action_deactivate": {
          "controls": "MasterKey",
          "value": 0
        }
      }
    },
    {
      "name": "GearLever",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "Q"
        }
      }
    },
    {
      "name": "LeftThrottleButton",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "Sand",
          "value": 1,
          "hold": true
        },
        "action_deactivate": {
          "controls": "Sand",
          "value": 0,
          "hold": false
        }
      }
    },
    {
      "name": "LeftEngineOn",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "Horn",
          "value": 1,
          "hold": true
        },
        "action_deactivate": {
          "controls": "Horn",
          "value": 0,
          "hold": false
        }
      }
    },
    {
      "name": "RightEngineOn",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "Horn",
          "value": -1,
          "hold": true
        },
        "action_deactivate": {
          "controls": "Horn",
          "value": 0,
          "hold": false
        }
      }
    },
    {
