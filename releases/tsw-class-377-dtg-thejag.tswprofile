        "action_activate": {
          "keys": "y"
        }
      }
    },
    {
      "name": "RudderTrimRight",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "u"
        }
      }
    },
    {
      "name": "RoundAuxButton",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "SignalBell",
          "value": 1,
          "hold": true
        },
        "action_deactivate": {
          "controls": "SignalBell",
          "value": 0,
          "hold": false
