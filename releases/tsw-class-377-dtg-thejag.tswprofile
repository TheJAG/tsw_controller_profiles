      "assignment": {
        "type": "toggle",
        "threshold": 0.9,
        "action_activate": {
          "controls": "AWS_Isolation",
          "value": 0,
          "hold": false,
          "enable_api_fallback": true
        },
        "action_deactivate": {
          "controls": "AWS_Isolation",
          "value": 1,
          "hold": false,
          "enable_api_fallback": true
        }
      }
