          "controls": "VirtualThrottle",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.0909,
              0.1818,
              0.2727,
              0.3636,
              0.4545,
              0.5454,
              0.6363,
              0.7272,
              0.8181,
              0.909,
              1
            ],
            "invert": true
          }
        },
        {
          "type": "sync_control",
          "identifier": "VirtualThrottle",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.0909,
              0.1818,
              0.2727,
              0.3636,
              0.4545,
              0.5454,
              0.6363,
              0.7272,
              0.8181,
              0.909,
              1
            ],
            "invert": true
          },
          "action_increase": {
            "keys": "a"
          },
          "action_decrease": {
            "keys": "d"
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "VirtualBrake",
          "input_value": {
            "min": 0,
            "max": 1,
