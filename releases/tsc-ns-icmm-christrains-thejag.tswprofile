              0,
              0.11,
              0.22,
              0.33,
              0.44,
              0.55,
              0.66,
              0.77,
              1
            ]
          },
          "action_increase": {
            "keys": "'"
          },
          "action_decrease": {
            "keys": ";"
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "keys": "v",
          "press_time": 0.1,
          "wait_time": 0.1
        },
        "action_deactivate": {
          "keys": "shift+v",
          "press_time": 0.1,
          "wait_time": 0.1
        }
      }
    },
