{
  "name": "TSC | NS ICMm | ChrisTrains | TheJAG",
  "controls": [
    {
      "name": "SpeedbrakeLever",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          }
        },
        {
          "type": "sync_control",
          "identifier": "Reverser",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          },
          "action_increase": {
            "keys": "w"
          },
          "action_decrease": {
            "keys": "s"
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "assignments": [
        {
