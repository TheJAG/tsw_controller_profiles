  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Reverser through ReverserProxy (Reverse 0 / Neutral 0.5 / Forward 1), inverted: Forward at the far end",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "ReverserProxy",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.5,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Fahr-/Bremsschalter PBC_L, incremental: Apply brake -1 (spring) / Hold brake -0.5 / Release brake, decrease power 0 / Hold power 0.5 / Increase power 1 (spring). Push the TCA to the far end to raise power, back one band to hold it; pull past the centre to brake the same way (which brake the brake side works on is set with BrakeSelection in the cab). Inverted: Increase raw 0 ±0.06, Hold power 0.25 ±0.12, Release / decrease 0.5 ±0.1, Hold brake 0.75 ±0.12, Apply brake 1 ±0.06",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "PBC_L",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              -0.5,
              0,
              0.5,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.06
              },
              {
                "threshold": 0.75,
                "threshold_tolerance": 0.12
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.1
              },
              {
                "threshold": 0.25,
                "threshold_tolerance": 0.12
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.06
              }
            ]
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "Führerbremsventil TrainBrake, self-lapping (Release 0 / Hold 0.5 / Apply 1; one gate per set), plain: Release at the far end, Apply nearest: Release 0 ±0.2, Hold 0.5 ±0.2, Apply 1 ±0.2",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "TrainBrake",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.5,
              1
            ],
            "step_thresholds": [
              {
                "threshold": 0,
                "threshold_tolerance": 0.2
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.2
              },
              {
                "threshold": 1,
                "threshold_tolerance": 0.2
              }
            ]
          }
        }
      ]
    },
