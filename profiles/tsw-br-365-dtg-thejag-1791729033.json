    {
      "name": "LeftThrottle",
      "description": "Fahrschalter Throttle_L, an incremental hydraulic-transmission handle (the 365 capture names the notches: Idle 0 / Fill-Run down 0.33 / Hold 0.67 / Increasing 1, the last a spring position that pulses the demand and falls back to Hold; one notch per set). Inverted: Increase at the far end, Idle nearest: Idle raw 1 ±0.1, Run down 0.72 ±0.12, Hold 0.4 ±0.14, Increase 0 ±0.1",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Throttle_L",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.33,
              0.67,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.1
              },
              {
                "threshold": 0.72,
                "threshold_tolerance": 0.12
              },
              {
                "threshold": 0.4,
                "threshold_tolerance": 0.14
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.1
              }
            ]
          }
        }
      ]
    },
