              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.15
              },
              {
                "threshold": 1,
                "threshold_tolerance": 0.15
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "description": "Brake key BrakeKey_F (Unlocked 0 / Locked 1: the Führerbremsventil only moves with it at 0) and the reverser lock ReverserLockButton_F (held 1 so the Richtungsschalter can go to Reverse): PARK BRK up = key in, lock held",
      "assignments": [
