    {
      "name": "LeftThrottle",
      "description": "Master controller Throttle -1..1 with the direction built in: P-3 Rev -1 / P-2 Rev -0.8 / P-1 Rev -0.6 / Switch Rev -0.4 / Off Rev -0.2 / Safety 0 / Off Fwd 0.2 / Switch Fwd 0.4 / P-1 Fwd 0.6 / P-2 Fwd 0.8 / P-3 Fwd 1; inverted: P-3 Forwards at the far end, Safety in the middle, P-3 Reverse nearest; eleven even bands. Needs the control plug in (PARK BRK up)",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Throttle",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              -0.8,
              -0.6,
              -0.4,
              -0.2,
              0,
              0.2,
              0.4,
              0.6,
              0.8,
              1
            ],
            "invert": true
          }
        }
      ]
    },
