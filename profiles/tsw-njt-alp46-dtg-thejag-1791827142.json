  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Reverser_F/_B (Reverse 0.333 / Neutral 0.666 / Forward 1; Isolated 0 stays in the cab; any value in a zone), inverted: Forward at the far end. Needs the reverser handle in (PARK BRK up) and the handle at Off",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser_{SIDE:F:B}",
          "input_value": {
            "min": 0.333,
            "max": 1,
            "steps": [
              0.333,
              0.666,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Combined throttle / dynamic brake PowerHandle_F/_B 0..1 (full dynamic 0 / dynamic continuous to 0.49 / Off 0.51 / P1 0.555 / power continuous 0.585..1), inverted as on the ACS-64: full power at the far end (raw 0 ±0.04), power zone 0.045..0.45, Off 0.5 ±0.05, dynamic zone 0.55..0.955, full dynamic 1 ±0.04 nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "PowerHandle_{SIDE:F:B}",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              null,
              0.51,
              null,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.955,
                "threshold_end": 0.55
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.05
              },
              {
                "threshold": 0.45,
                "threshold_end": 0.045
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.04
              }
            ]
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "Automatic brake AutomaticBrake_F/_B (Release 0 / Hold 0.2 / Lap 0.4 / Service 0.6 / Handle Off 0.8 / Emergency 1, all notches), inverted: Emergency at the far end, Release nearest, six even bands",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "AutomaticBrake_{SIDE:F:B}",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.2,
              0.4,
              0.6,
              0.8,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "FlapLever",
      "description": "Independent brake IndependentBrake_F/_B (Release 0.1 / continuous 0.2..0.9 / Full 1), inverted: Full at the far end, Release nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "IndependentBrake_{SIDE:F:B}",
          "input_value": {
            "min": 0.1,
            "max": 1,
            "invert": true
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "description": "Reverser handle ReverserHandle_F/_B (MasterSwitch push button: In 1 / 0): PARK BRK up = handle in (the leading cab loads with it in)",
      "assignments": [
        {
          "type": "momentary",
          "threshold": 0.9,
          "action_activate": {
            "controls": "ReverserHandle_{SIDE:F:B}",
            "value": 1,
            "hold": false,
            "enable_api_fallback": true
          },
          "action_deactivate": {
            "controls": "ReverserHandle_{SIDE:F:B}",
            "value": 0,
            "hold": false,
            "enable_api_fallback": true
          }
        }
      ]
    },
