      "assignments": [
        {
          "type": "direct_control",
          "controls": "TrainBrake (IrregularLever)",
          "input_value": {
            "min": 0.15,
            "max": 0.85,
            "steps": [
              0.15,
              0.35,
              null,
              0.65,
              0.85
