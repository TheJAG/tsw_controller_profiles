  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Richtungsschalter MasterSwitch_F (Reverse 0 / Off 0.5 / Forward 1), inverted: Forward at the far end. Moves only at Fahrstufe 0; Reverse needs the reverser lock button, held through PARK BRK",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "MasterSwitch_F (IrregularLever)",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.5,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Fahrschalter handwheel PowerController_F: a spring wheel (rest 0.5) that winds the tap changer up (1) or down (0), Fahrstufe 0..18 in TertiaryValue. Inverted: push to the far end to wind up, centre to hold, pull to wind down. Through the API one set pulses about a quarter Stufe; the mode switch holds the wheel instead. Wind up raw 0 ±0.25, Hold 0.5 ±0.2, Wind down 1 ±0.25",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "PowerController_F (E94Controller)",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.5,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.25
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.2
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.25
              }
            ]
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "Führerbremsventil TrainBrake_F (ÖBB valve: Shutdown 0 stays in the cab / Running 0.3 / 1st application 0.45 / Service continuous to Full 0.85 / Emergency 1; one gate per set), inverted as the 153 brake: Emergency at the far end, Running nearest. Emergency raw 0 ±0.06, Full 0.16 ±0.05, free zone 0.24..0.78 (full down to 1st application), 1st application 0.84 ±0.04 (detent), Running 1 ±0.08. Needs the brake key and master key (PARK BRK up)",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "TrainBrake_F (IrregularLever)",
          "input_value": {
            "min": 0.3,
            "max": 1,
            "steps": [
              0.3,
              0.45,
              null,
              0.85,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.08
              },
              {
                "threshold": 0.84,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.78,
                "threshold_end": 0.24
              },
              {
                "threshold": 0.16,
                "threshold_tolerance": 0.05
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.06
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FlapLever",
      "description": "Zusatzbremse LocoBrakeValve_F (Release 0 / Hold 0.5 / Apply 1, the Apply end is a spring position that never stored in the probe), plain: Release at the far end, Apply nearest: Release 0 ±0.15, Hold 0.5 ±0.15, Apply 1 ±0.15",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "LocoBrakeValve_F",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.5,
              1
            ],
            "step_thresholds": [
              {
                "threshold": 0,
                "threshold_tolerance": 0.15
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.15
              },
              {
                "threshold": 1,
                "threshold_tolerance": 0.15
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "description": "Master key MasterKeySwitch_F (lever, Unlocked 1 / Locked 0; loads Locked), brake key BrakeKey_F (Unlocked 0 / Locked 1; loads Locked) and the reverser lock ReverserLockButton_F (held 1 so the Richtungsschalter can go to Reverse): PARK BRK up = keys in, lock held",
      "assignments": [
        {
          "type": "momentary",
          "threshold": 0.9,
          "action_activate": {
            "controls": "MasterKeySwitch_F (Lever)",
            "value": 1,
            "hold": false,
            "enable_api_fallback": true
          },
          "action_deactivate": {
            "controls": "MasterKeySwitch_F (Lever)",
            "value": 0,
            "hold": false,
            "enable_api_fallback": true
          }
        },
        {
