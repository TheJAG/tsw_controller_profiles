  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Direction switch (Reverse -1 / Neutral 0 / Forward 1), inverted: Forward at the far end",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "DirectionSwitch",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Power / brake handle (Maximum braking 0.1 / brake continuous 0.11..0.49 / Off 0.5 / power continuous 0.51..1; Emergency at 0.02..0.04 is left out on purpose). Power is pulled towards the driver, so the lever is plain: Max brake raw 0 +-0.04, brake zone 0.05..0.46, Off 0.5 +-0.03, power zone 0.54..0.955, full power 1 +-0.04",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "PowerHandle",
          "input_value": {
            "min": 0.1,
            "max": 1,
            "steps": [
              0.1,
              null,
              0.5,
              null,
              1
            ],
            "step_thresholds": [
              {
                "threshold": 0,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.05,
                "threshold_end": 0.46,
                "threshold_tolerance": 0
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.03
              },
              {
                "threshold": 0.54,
                "threshold_end": 0.955,
                "threshold_tolerance": 0
              },
              {
                "threshold": 1,
                "threshold_tolerance": 0.04
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "description": "Master key in / out",
      "assignment": {
        "type": "momentary",
        "threshold": 0.9,
        "action_activate": {
          "controls": "MasterKey",
          "value": 1,
          "hold": false,
          "enable_api_fallback": true
        },
        "action_deactivate": {
          "controls": "MasterKey",
          "value": 0,
