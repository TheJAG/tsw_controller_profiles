      "name": "LeftThrottle",
      "description": "Throttle Idle 0.11 / N1..N7 at 0.22..0.88 / N8 1.0 (the stored positions; nothing below Idle, 0 would stop the engine), inverted: N8 at the far end, Idle nearest. Locked while the transition lever is in Off",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Throttle",
          "input_value": {
            "min": 0.11,
            "max": 1,
            "steps": [
              0.11,
              0.22,
              0.33,
              0.44,
              0.55,
              0.66,
              0.77,
              0.88,
              1
            ],
            "invert": true
          }
        }
      ]
    },
