{
  "name": "TSW | KiHa40 | DTG | TheJAG",
  "auto_select": true,
  "apps": [
    "Train Sim World"
  ],
  "rail_class_information": [
    {
      "class_name": "RVM_UWS_Kiha40-500_Base_C"
    }
  ],
  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Reverser Handle_Reverser_F(Lever) (Backward -1 / Neutral 0 / Forward 1; the zones take any value), inverted: Forward at the far end. Needs the handles plugged and the master key on (PARK BRK up)",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Handle_Reverser_F(Lever)",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Throttle Handle_Regulator_F(Lever) Idle 0 .. P5 5 (integer notches, ±0.5 bands), plain as the Class 153: pulled towards you to notch up, Idle at the far end",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Handle_Regulator_F(Lever)",
          "input_value": {
            "min": 0,
            "max": 5,
            "steps": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "ME23 brake valve Handle_Brake_F(Lever) Release 0 / Holding 0.25 / Handle Off 0.5 / Lap 0.75 / Apply 1 / Emergency 1.5, inverted as the Class 153 brake: Emergency at the far end, Release nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Handle_Brake_F(Lever)",
          "input_value": {
            "min": 0,
            "max": 1.5,
            "steps": [
              0,
              0.25,
              0.5,
              0.75,
              1,
              1.5
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "FlapLever",
      "description": "Gear lever Handle_GearLever_F(Lever) Hydraulic -1 / Neutral 0 / Direct 1, inverted: Direct drive at the far end, Hydraulic nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Handle_GearLever_F(Lever)",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "description": "Handles in: plug the master, brake, engine and gear handles (Handle_*_Active_F(Toggle) Plugged 1 / Removed 0), then the master key Handle_MasterKey_F(Lever) Activated 1. PARK BRK up = handles in, key on",
      "assignments": [
        {
          "type": "momentary",
          "threshold": 0.9,
          "action_activate": {
            "controls": "Handle_Master_Active_F(Toggle)",
            "value": 1,
            "hold": false,
            "enable_api_fallback": true
          },
          "action_deactivate": {
            "controls": "Handle_Master_Active_F(Toggle)",
            "value": 0,
            "hold": false,
            "enable_api_fallback": true
          }
        },
        {
