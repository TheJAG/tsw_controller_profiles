  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Reverser (Off 0 / Forward 0.5 / Reverse 1; no Neutral, Off is the middle state), plain: Off at the far end, Forward in the middle, Reverse nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.5,
              1
            ]
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Throttle (Idling 0 / 1 0.25 / 2 0.5 / 3 0.75 / Full 1), plain as the Class 153: Idling at the far end, Full nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Throttle",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ]
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "Vacuum brake DriversBrakeValve (Released 0 / release zone to 0.47 / Lap 0.5 / apply zone 0.55..1 / full application 1), inverted as the Class 153 brake: full application at the far end, Released nearest. Released raw 1 ±0.08, release zone 0.9..0.58, Lap 0.5 ±0.06, apply zone 0.42..0.08, full 0 ±0.06",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "DriversBrakeValve",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              null,
              0.5,
              null,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.08
              },
              {
                "threshold": 0.9,
                "threshold_end": 0.58
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.06
              },
              {
                "threshold": 0.42,
                "threshold_end": 0.08
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.06
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FlapLever",
      "description": "Gear selector GearSelector (1st 0 / 2nd 0.25 / 3rd 0.5 / 4th 0.75 / Neutral 1; it only moves with both keys in, the engines running and the reverser in Forward), inverted: Neutral at the far end, then 4th, 3rd, 2nd, 1st nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "GearSelector",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "description": "Main switch MainSwitch (MasterSwitch push button, On 1 / Off 0) and AWS change-end key AWS_ChangeEnd (lever, On 1 / Off 0): PARK BRK up = both in",
      "assignments": [
        {
          "type": "momentary",
          "threshold": 0.9,
          "action_activate": {
            "controls": "MainSwitch",
            "value": 1,
            "hold": false,
            "enable_api_fallback": true
          },
          "action_deactivate": {
            "controls": "MainSwitch",
