  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Reverser (Engine only 0 / Reverse 0.25 / Off 0.5 / Forward 0.75; the second Engine only at 1 is left out), inverted: Forward at the far end, Engine only nearest. It only leaves Forward with the power controller at Off",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser_F",
          "input_value": {
            "min": 0,
            "max": 0.75,
            "steps": [
              0,
              0.25,
              0.5,
              0.75
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Driver's brake valve (Running 0.1 / Initial application 0.25 / Service continuous 0.26..0.75 / Full service 0.8 / Emergency 0.9; Release and Shutdown are left out, the loco loads at Shutdown). Plain: Running at the far end, Emergency nearest; Initial application on the 0.31 detent, Full service on the 0.84 FLX detent",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "DriversBrake_F",
          "input_value": {
            "min": 0.1,
            "max": 0.9,
            "steps": [
              0.1,
              0.25,
              null,
              0.8,
              0.9
            ],
            "step_thresholds": [
              {
                "threshold": 0,
                "threshold_tolerance": 0.045
              },
              {
                "threshold": 0.31,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.36,
                "threshold_end": 0.78,
                "threshold_tolerance": 0
              },
              {
                "threshold": 0.84,
                "threshold_tolerance": 0.045
              },
              {
                "threshold": 1,
                "threshold_tolerance": 0.04
              }
            ]
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "Power controller (Off 0 / On 0.1 / continuous 0.13..1; it only moves with the engines running and the reverser in Forward). Plain: Off at the far end, full power nearest; On on the 0.31 idle detent",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Throttle_F",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
