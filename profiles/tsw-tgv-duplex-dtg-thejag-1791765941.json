          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Manipulateur traction / freinage PowerHandle -1..1 (max brake -1 / brake continuous / 0 / min power 0.15 / power continuous to 1). SNG geometry, inverted: max power at the far end (raw 0 ±0.04), power zone 0.045..0.42, min power 0.45 ±0.03, 0 at 0.5 ±0.03, brake zone 0.56..0.955, max brake 1 ±0.04 nearest. The handle only moves with the master switch Active and the driving mode Manual (PARK BRK up)",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "PowerHandle",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              null,
              0,
              0.15,
              null,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.955,
                "threshold_end": 0.56
              },
