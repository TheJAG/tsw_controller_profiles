  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Reverser (Reverse 0.33 / Neutral 0.66 / Forward 1; Isolate 0 stays in the cab; any value in a zone), inverted: Forward at the far end. Needs the reverser handle in (PARK BRK up) and the handle at Off",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser",
          "input_value": {
            "min": 0.33,
            "max": 1,
            "steps": [
              0.33,
              0.66,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Combined throttle / dynamic brake MasterController -1..1 (full dynamic -1 / dynamic continuous / Off 0 / power continuous / full power 1), inverted as on the ACS-64: full power at the far end (raw 0 ±0.04), power zone 0.045..0.45, Off 0.5 ±0.05, dynamic zone 0.55..0.955, full dynamic 1 ±0.04 nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "MasterController",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              null,
              0,
              null,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.955,
                "threshold_end": 0.55
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.05
              },
              {
                "threshold": 0.45,
                "threshold_end": 0.045
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.04
              }
            ]
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "Automatic brake AutomaticBrake (Release 0 / Hold 0.2 / Lap 0.4 / Service 0.6 / Handle Off 0.8 / Emergency 1, all notches), inverted: Emergency at the far end, Release nearest, six even bands",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "AutomaticBrake",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.2,
              0.4,
              0.6,
              0.8,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "FlapLever",
      "description": "Independent brake IndependentBrake (Release 0.1 / continuous to Full 1), inverted: Full at the far end, Release nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "IndependentBrake",
          "input_value": {
            "min": 0.1,
            "max": 1,
            "invert": true
          }
        }
      ]
    },
    {
