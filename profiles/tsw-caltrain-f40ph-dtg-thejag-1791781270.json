  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Reverser (Reverse -1 / Neutral 0 / Forward 1; any value in a zone), inverted: Forward at the far end. Needs the reverser handle in (PARK BRK up); the dynamic brake only moves out of Neutral",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Throttle Idle / notches 1..8 (step values on the stored positions), inverted: notch 8 at the far end (pushed away), Idle nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Throttle",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.125,
              0.25,
              0.375,
              0.5,
              0.625,
              0.75,
              0.875,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "Automatic brake AutomaticBrake (six detents, no service zone: Release 0 / Holding 0.2 / Lap 0.4 / Service 0.6 / Handle Off 0.8 / Emergency 1), inverted: Emergency at the far end, Release nearest, even bands",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "AutomaticBrake",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.2,
              0.4,
              0.6,
              0.8,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "FlapLever",
      "description": "Dynamic brake DynamicBrake (Off 0 / Setup 0.15 / B1 0.275 / continuous to 1 = 8), inverted: full dynamic at the far end (raw 0 ±0.04), zone 0.045..0.86, Set Up 0.9 ±0.03, Off 1 ±0.06 nearest. Locked while the reverser is in Neutral",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "DynamicBrake",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.15,
              null,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.06
              },
              {
                "threshold": 0.9,
                "threshold_tolerance": 0.03
              },
              {
                "threshold": 0.86,
                "threshold_end": 0.045
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.04
              }
            ]
          }
        }
      ]
    },
