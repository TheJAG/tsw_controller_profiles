  "controls": [
    {
      "name": "SpeedbrakeLever",
      "description": "Reverser (Reverse -1 / Neutral 0 / Forward 1; any value in a zone), inverted: Forward at the far end. Needs the reverser handle in (PARK BRK up); locked while the selector is in B",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              0,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Throttle ThrottleLever (Throttle) Idle 0.11 / N1..N7 at 0.22..0.88 / N8 1.0 (stored positions, nothing below Idle), inverted: N8 at the far end, Idle nearest. Only moves with the selector on 1..4",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "ThrottleLever (Throttle)",
          "input_value": {
            "min": 0.11,
            "max": 1,
            "steps": [
              0.11,
              0.22,
              0.33,
              0.44,
              0.55,
              0.66,
              0.77,
              0.88,
              1
            ],
            "invert": true
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "26L automatic brake AutomaticBrake (Release 0 / Initial reduction 0.125 / service continuous 0.2..0.6 / Full Service 0.65 / Suppression 0.7 / Handle Off 0.9 / Emergency 1), inverted: Emergency at the far end (raw 0 ±0.04), Handle Off 0.1, Suppression 0.2, Full Service 0.3, service zone 0.36..0.86, Initial 0.9 ±0.03, Release 1 ±0.06 nearest. Dead until the cut-off pilot valve is at Freight (PARK BRK up)",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "AutomaticBrake",
          "input_value": {
            "min": 0,
            "max": 1,
            "steps": [
              0,
              0.125,
              null,
              0.65,
              0.7,
              0.9,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.06
              },
              {
                "threshold": 0.9,
                "threshold_tolerance": 0.03
              },
              {
                "threshold": 0.86,
                "threshold_end": 0.36
              },
              {
                "threshold": 0.3,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.2,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.1,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.04
              }
            ]
          }
        }
      ]
    },
    {
