      "description": "Dynamic brake handle \"ThrottleLever (DynamicBrake)\" (Off 0.11 / continuous to 0.95 = 100 %; acts with the selector in B), inverted: full at the far end, Off nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "ThrottleLever (DynamicBrake)",
          "input_value": {
            "min": 0.11,
            "max": 0.95,
            "invert": true
          }
        }
      ]
    },
