    {
      "name": "SpeedbrakeLever",
      "description": "Cut-off Reverser_RailDriver -1..1 (-75 % .. +75 %, Mid-gear 0; the screw Reverser follows it), continuous, inverted: full forward gear at the far end, full back gear nearest. Mid-gear at raw 0.5 ±0.03",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Reverser_RailDriver",
          "input_value": {
            "min": -1,
            "max": 1,
            "steps": [
              -1,
              null,
              0,
              null,
              1
            ],
            "invert": true,
            "step_thresholds": [
              {
                "threshold": 1,
                "threshold_tolerance": 0.04
              },
              {
                "threshold": 0.955,
                "threshold_end": 0.535
              },
              {
                "threshold": 0.5,
                "threshold_tolerance": 0.03
              },
              {
                "threshold": 0.465,
                "threshold_end": 0.045
              },
              {
                "threshold": 0,
                "threshold_tolerance": 0.04
              }
            ]
          }
        }
      ]
    },
    {
      "name": "LeftThrottle",
      "description": "Regulator (Throttle) continuous 0..1, plain: Closed at the far end, pulled towards you to open, Fully open nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "Regulator",
          "input_value": {
            "min": 0,
            "max": 1
          }
        }
      ]
    },
    {
      "name": "RightThrottle",
      "description": "Vacuum brake valve VacuumBrake (continuous 0..1, Release 0 / Full application 1), inverted as the Class 153 brake: Full application at the far end, Release nearest",
      "assignments": [
        {
          "type": "direct_control",
          "controls": "VacuumBrake",
          "input_value": {
            "min": 0,
            "max": 1,
            "invert": true
          }
        }
      ]
    },
    {
      "name": "ParkingBrake",
      "description": "Large ejector SteamEjector_Large (open 1 / closed 0) to create the vacuum before departure: PARK BRK up = open. The steam brake is not driver-settable on this loco (it follows the vacuum valve)",
      "assignments": [
        {
          "type": "momentary",
          "threshold": 0.9,
          "action_activate": {
            "controls": "SteamEjector_Large",
            "value": 1,
            "hold": false,
            "enable_api_fallback": true
          },
          "action_deactivate": {
            "controls": "SteamEjector_Large",
            "value": 0,
            "hold": false,
            "enable_api_fallback": true
          }
