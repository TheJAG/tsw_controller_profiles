        {
          "kind": "howto",
          "title": "How to drive",
          "cols": 3,
          "blocks": [
            {
              "title": "RABe 523: Signum and ETCS",
              "steps": [
                "At a stand select the ETCS level on the right display, then confirm with **ENG 1**.",
                "Level 1: 40 km/h in SR to the first balise, then follow the FS speed and curve.",
                "STM / Signum: at a Warnung press **Signum reset** (gear lever) at once."
              ]
            },
            {
              "title": "RhB: ZS / ZSI",
              "steps": [
                "Switch the ZSI on (Allegra left aux; always on in the Ge 4/4 II).",
                "At a distant at Warnung or a Kurze Fahrt: two beeps, yellow lamp flashing: press **ZS** (Allegra ENG 1, Ge 4/4 II gear lever).",
                "Missed: red lamp and emergency brake; stop, release."
              ]
            },
            {
              "title": "Vigilance",
              "steps": [
                "Allegra: SiSte on (right aux); reset with the **gear lever** when its button lights.",
                "Ge 4/4 II: keep the deadman cut in: left aux **dark**.",
                "Missed: emergency brake; stop, reset, release."
              ]
            }
          ]
        },
        {
          "kind": "callout",
          "title": "Before departure:",
          "text": "Allegra: ZSI and SiSte on (both load off; aux squares lit). Ge 4/4 II: deadman cut in (left aux dark). RABe 523: ETCS on, level selected and confirmed. Check the signal, close the doors."
        }
      ]
